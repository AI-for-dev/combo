{
	"name": "@ai-for-dev/combo",
	"version": "0.1.1",
	"description": "Write pi subagents and compose workflows, simply",
	"license": "MIT",
	"author": "AI-for-dev team",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AI-for-dev/combo.git"
	},
	"homepage": "https://ai-for-dev.github.io/combo/",
	"keywords": [
		"pi",
		"pi-package",
		"subagent",
		"agent",
		"workflow"
	],
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"pi": {
		"extensions": [
			"./extension/index.ts"
		]
	},
	"files": [
		"src",
		"extension",
		"pane",
		"agents",
		"pipelines",
		"flows",
		"LICENSE",
		"README.md",
		"docs",
		"!docs/_build",
		"!docs/__pycache__",
		"!docs/conf.py",
		"!docs/Makefile",
		"!docs/requirements.txt",
		"!docs/_pygments.py",
		"!docs/_static/custom.css",
		"!docs/_static/fonts"
	],
	"engines": {
		"node": ">=23.6"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"test": "node --test 'test/*.test.ts'",
		"docs": "node scripts/gen-docs.ts",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.80.6",
		"@earendil-works/pi-tui": ">=0.80.6",
		"typebox": "^1.1.38",
		"@types/node": "^24.13.3",
		"typescript": "^5.9.0"
	}
}
