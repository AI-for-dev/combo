{
	"name": "combo",
	"version": "0.1.0",
	"description": "Write pi subagents and compose workflows, simply",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AI-for-dev/combo.git"
	},
	"homepage": "https://ai-for-dev.github.io/combo/",
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"src",
		"extension",
		"agents",
		"pipelines",
		"README.md",
		"docs",
		"!docs/conf.py",
		"!docs/Makefile",
		"!docs/requirements.txt",
		"!docs/_pygments.py",
		"!docs/_static/custom.css",
		"!docs/_static/fonts"
	],
	"engines": {
		"node": ">=23.6"
	},
	"scripts": {
		"test": "node --test 'test/*.test.ts'",
		"docs": "node scripts/gen-docs.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": ">=0.80.6"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"typescript": "^5.9.0"
	}
}
