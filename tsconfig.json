{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["esnext"],
		"module": "nodenext",
		"moduleResolution": "nodenext",

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,

		// Node exécute le TypeScript nativement : il efface les types, il ne les
		// compile pas. `erasableSyntaxOnly` interdit donc enum, namespace et
		// paramètres-propriétés, qui demanderaient une vraie étape de build.
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"noEmit": true,

		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "examples/**/*.ts", "extension/**/*.ts"]
}
